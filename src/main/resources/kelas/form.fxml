<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController" stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Manajemen Produk" styleClass="title"/>
            <Button text="Lihat Daftar" onAction="#bukaDaftar"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Tambah Produk Baru" styleClass="subtitle"/>
                        <Label text="Nama produk"/>
                        <TextField fx:id="namaField" promptText="Contoh: Seblak"/>
                        <Label text="Kategori produk"/>
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity"/>
                        <Label text="Harga produk"/>
                        <TextField fx:id="hargaField" promptText="Contoh: 17000"/>
                        <Label text="Foto Produk (Opsional)"/>
                        <ImageView fx:id="fotoPreview" fitWidth="220" fitHeight="170"
                                   preserveRatio="true" visible="false" managed="false"/>
                        <HBox spacing="10">
                            <Button text="Pilih Gambar" onAction="#pilihGambar"/>
                            <Button fx:id="hapusFotoBtn" text="Hapus Gambar" onAction="#hapusGambar"
                                    visible="false" managed="false"/>
                        </HBox>
                        <Label text="PNG/JPEG. File lokal, bukan upload ke server." styleClass="muted" wrapText="true"/>
                        <Label text="Kode produk dibuat otomatis (PRD001, PRD002, ...)." styleClass="muted" wrapText="true"/>
                        <Button text="Simpan dan Lihat Detail" onAction="#simpan" styleClass="button-primary" maxWidth="Infinity"/>
                        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
